{
  "name": "transactional-lottery-platform-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run pwa:generate",
    "pwa:generate": "node scripts/generate-service-worker.mjs",
    "pwa:icons": "node scripts/generate-pwa-icons.mjs",
    "lint": "eslint .",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "test:e2e": "playwright test --project=chromium --project=android",
    "test:e2e:firefox": "playwright test e2e/smoke.spec.js --project=firefox --workers=1",
    "test:pwa": "npm run build && playwright test --config playwright.pwa.config.js",
    "test:performance": "npm run build && playwright test --config playwright.performance.config.js",
    "test:staging": "node scripts/check-staging-readiness.mjs",
    "test:e2e:visual": "playwright test e2e/visual.spec.js --update-snapshots",
    "test:a11y": "playwright test e2e/quality.spec.js --project=chromium",
    "test:budget": "node scripts/check-bundle-budget.mjs",
    "preview": "vite preview",
    "demo:build": "vite build --mode demo && npm run pwa:generate",
    "demo:preview": "vite preview --mode demo"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.102.8",
    "lucide-react": "^1.39.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "react-router-dom": "^7.18.3",
    "tailwindcss": "^4.3.3",
    "web-vitals": "^6.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "workbox-build": "^7.4.1"
  }
}
