NODE_ENV=development
PORT=2000
APP_RELEASE=local
MYSQL_HOST=127.0.0.1
MYSQL_USER=portfolio_app
MYSQL_PASSWORD=replace-with-a-local-password
MYSQL_DB=portfolio_lottery_platform
JWT_SECRET=replace-with-a-secure-random-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=false
REQUIRE_HTTPS=false
PROCESS_ROLE=all
MYSQL_CONNECTION_LIMIT=20
MYSQL_QUEUE_LIMIT=50
MYSQL_ACQUIRE_TIMEOUT_MS=1000
MYSQL_QUERY_TIMEOUT_MS=8000
MYSQL_LOCK_WAIT_TIMEOUT_SECONDS=5
OBSERVABILITY_TOKEN=replace-with-a-separate-random-observability-token
HTTP_REQUEST_TIMEOUT_MS=15000
HTTP_HEADERS_TIMEOUT_MS=10000
HTTP_KEEP_ALIVE_TIMEOUT_MS=5000
SHUTDOWN_TIMEOUT_MS=10000
EMAIL_PROVIDER=disabled
TWILIO_API_KEY_SID=SK00000000000000000000000000000000
TWILIO_API_KEY_SECRET=replace-with-a-twilio-api-key-secret
EMAIL_FROM=Lottery Demo <security@example.test>
EMAIL_CODE_SECRET=replace-with-an-independent-random-secret-of-32-bytes
EMAIL_REQUEST_TIMEOUT_MS=5000
